rules_version = '2';
// The app keeps no data in Firestore: prompts, skills and connectors ship inside the APK, and subscriptions live in
// the old licence servers. Everything here stays closed until the Firebase rules are written (Phase 4).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
